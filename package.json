{
  "name": "playwright-e2e-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript E2E framework demonstrating the Page Object Model, component objects and custom fixtures.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:healing": "playwright test --grep @healing",
    "test:regression": "playwright test --grep @regression",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.saucedemo.com",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
